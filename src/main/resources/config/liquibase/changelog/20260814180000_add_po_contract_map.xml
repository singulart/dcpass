<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Maps a purchase order's unversioned number (ponumber_base, e.g. PO601566) to
        contract numbers. Rows are populated locally by !data_cleanup scripts and
        copied to prod; Liquibase does not install or run those functions.
    -->
    <changeSet id="20260814180000-1" author="dcpass">
        <createTable tableName="po_contract_map">
            <column name="ponumber_base" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="contractnumber" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_po_contract_map_contractnumber" tableName="po_contract_map">
            <column name="contractnumber"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
