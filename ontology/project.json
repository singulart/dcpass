{
  "name": "ontology",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "tags": ["type:ontology"],
  "targets": {
    "codegen-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npm run build", "foundry install ontology"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen-bootstrap"],
      "options": {
        "command": "foundry generate-osdk"
      }
    }
  }
}
