{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "#generated-imports": ["./src/generated-imports/index.ts"]
    }
  },
  "include": ["src/**/*.mts", "src/generated-imports/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
